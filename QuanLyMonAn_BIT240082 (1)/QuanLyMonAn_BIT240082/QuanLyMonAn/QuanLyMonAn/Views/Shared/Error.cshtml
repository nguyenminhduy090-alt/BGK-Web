@{
    ViewData["Title"] = Localizer["Not Found"];
}
<div class="text-center py-5">
    <h1 class="display-4">⚠️ @Localizer["Not Found"]</h1>
    <p class="lead text-muted">@Localizer["The item you are looking for does not exist or has been deleted."]</p>
    <a class="btn btn-primary" asp-controller="Dishes" asp-action="Index">@Localizer["Back to List"]</a>
</div>
