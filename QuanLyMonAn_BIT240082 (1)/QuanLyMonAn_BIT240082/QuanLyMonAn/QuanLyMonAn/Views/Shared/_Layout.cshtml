@{
    var currentCulture = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    var returnUrl = Context.Request.Path.ToString() + Context.Request.QueryString.ToString();
}
<!DOCTYPE html>
<html lang="@currentCulture">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@Localizer["Dish Management"] - BIT240082</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4">
        <div class="container">
            <a class="navbar-brand" asp-controller="Dishes" asp-action="Index">🍽️ @Localizer["Dish Management"]</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMenu">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navMenu">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Dishes" asp-action="Index">@Localizer["Dishes"]</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="DishCategories" asp-action="Index">@Localizer["Categories"]</a>
                    </li>
                </ul>
                <div class="d-flex align-items-center">
                    <span class="text-light me-2 small">@Localizer["Language"]:</span>
                    <a class="btn btn-sm @(currentCulture == "en" ? "btn-light" : "btn-outline-light") me-1"
                       asp-controller="Home" asp-action="SetLanguage"
                       asp-route-culture="en" asp-route-returnUrl="@returnUrl">English</a>
                    <a class="btn btn-sm @(currentCulture == "vi" ? "btn-light" : "btn-outline-light")"
                       asp-controller="Home" asp-action="SetLanguage"
                       asp-route-culture="vi" asp-route-returnUrl="@returnUrl">Tiếng Việt</a>
                </div>
            </div>
        </div>
    </nav>

    <div class="container">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @Localizer[TempData["SuccessMessage"]?.ToString() ?? ""]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                @Localizer[TempData["ErrorMessage"]?.ToString() ?? ""]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <main>
            @RenderBody()
        </main>
    </div>

    <footer class="text-center text-muted py-4 mt-5 border-top">
        <small>BIT240082 - Nguyễn Minh Duy | @Localizer["Dish Management"]</small>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
