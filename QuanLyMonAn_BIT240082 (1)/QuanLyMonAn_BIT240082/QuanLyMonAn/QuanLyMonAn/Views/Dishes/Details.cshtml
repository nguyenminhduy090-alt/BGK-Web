@model Dish_BIT240082
@{
    ViewData["Title"] = Localizer["Details"];
}

<h2>@Model.Name</h2>

<div class="row">
    <div class="col-md-6">
        <table class="table">
            <tr>
                <th>@Localizer["Category"]</th>
                <td>@Model.DishCategory?.Name</td>
            </tr>
            <tr>
                <th>@Localizer["Price"]</th>
                <td>@Model.Price.ToString("N0", System.Globalization.CultureInfo.GetCultureInfo("vi-VN")) ₫</td>
            </tr>
            <tr>
                <th>@Localizer["Preparation Time"]</th>
                <td>
                    @Model.PreparationTime @Localizer["min"] —
                    @if (Model.PreparationClassification == "Quick")
                    {
                        <span class="badge bg-success">@Localizer["Quick"]</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">@Localizer["Regular"]</span>
                    }
                </td>
            </tr>
            <tr>
                <th>@Localizer["Status"]</th>
                <td>
                    @if (Model.IsAvailable)
                    {
                        <span class="badge bg-primary">@Localizer["Available"]</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">@Localizer["Unavailable"]</span>
                    }
                </td>
            </tr>
            <tr>
                <th>@Localizer["Description"]</th>
                <td>@Model.Description</td>
            </tr>
        </table>

        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">@Localizer["Edit"]</a>
        <a asp-action="Index" class="btn btn-secondary">@Localizer["Back to List"]</a>
    </div>

    <div class="col-md-6">
        <h4>@Localizer["Images"]</h4>

        @if (!Model.DishImages.Any())
        {
            <p class="text-muted">@Localizer["No images yet for this dish."]</p>
        }
        else
        {
            <div class="row row-cols-2 g-2 mb-3">
                @foreach (var img in Model.DishImages)
                {
                    <div class="col">
                        <div class="card">
                            <img src="@img.ImageUrl" class="card-img-top" style="height:120px;object-fit:cover" />
                            <div class="card-body p-2 text-center">
                                @if (img.IsThumbnail)
                                {
                                    <span class="badge bg-success d-block mb-1">@Localizer["Thumbnail"]</span>
                                }
                                else
                                {
                                    <form asp-action="SetThumbnail" method="post" class="d-inline">
                                        <input type="hidden" name="imageId" value="@img.Id" />
                                        <input type="hidden" name="dishId" value="@Model.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-primary mb-1">@Localizer["Set as Thumbnail"]</button>
                                    </form>
                                }
                                <form asp-action="DeleteImage" method="post" class="d-inline"
                                      onsubmit="return confirm('@Localizer["Are you sure you want to delete this?"]');">
                                    <input type="hidden" name="imageId" value="@img.Id" />
                                    <input type="hidden" name="dishId" value="@Model.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger">@Localizer["Delete"]</button>
                                </form>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }

        <form asp-action="AddImage" method="post" class="card card-body bg-light">
            <input type="hidden" name="dishId" value="@Model.Id" />
            <label class="form-label small">@Localizer["Image URL"]</label>
            <input type="url" name="imageUrl" class="form-control mb-2" placeholder="https://..." required />
            <div class="form-check mb-2">
                <input type="checkbox" name="setAsThumbnail" value="true" class="form-check-input" id="setThumb" />
                <label class="form-check-label small" for="setThumb">@Localizer["Set as thumbnail when adding"]</label>
            </div>
            <button type="submit" class="btn btn-sm btn-primary">@Localizer["Add Image"]</button>
        </form>
    </div>
</div>
