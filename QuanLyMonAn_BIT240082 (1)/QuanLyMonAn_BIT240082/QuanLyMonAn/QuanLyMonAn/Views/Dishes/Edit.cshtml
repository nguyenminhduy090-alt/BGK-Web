@model DishFormViewModel
@{
    ViewData["Title"] = Localizer["Edit Dish"];
}

<h2>@Localizer["Edit Dish"]</h2>

<div class="card card-body" style="max-width:600px">
    <form asp-action="Edit" method="post">
        <input type="hidden" asp-for="Id" />
        <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

        <div class="mb-3">
            <label asp-for="Name" class="form-label">@Localizer["Dish Name"]</label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="DishCategoryId" class="form-label">@Localizer["Category"]</label>
            <select asp-for="DishCategoryId" asp-items="Model.Categories" class="form-select">
                <option value="">@Localizer["Select a category"]</option>
            </select>
            <span asp-validation-for="DishCategoryId" class="text-danger"></span>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="Price" class="form-label">@Localizer["Price"]</label>
                <input asp-for="Price" type="number" step="0.01" class="form-control" />
                <span asp-validation-for="Price" class="text-danger"></span>
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="PreparationTime" class="form-label">@Localizer["Preparation Time"] (@Localizer["min"])</label>
                <input asp-for="PreparationTime" type="number" class="form-control" />
                <span asp-validation-for="PreparationTime" class="text-danger"></span>
            </div>
        </div>

        <div class="mb-3">
            <label asp-for="Description" class="form-label">@Localizer["Description"]</label>
            <textarea asp-for="Description" class="form-control" rows="3"></textarea>
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>

        <div class="form-check mb-3">
            <input asp-for="IsAvailable" class="form-check-input" />
            <label asp-for="IsAvailable" class="form-check-label">@Localizer["Is Available"]</label>
        </div>

        <button type="submit" class="btn btn-success">@Localizer["Save"]</button>
        <a asp-action="Index" class="btn btn-secondary">@Localizer["Cancel"]</a>
    </form>
</div>
